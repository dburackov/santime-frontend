# Публичный адрес витрины: canonical, Open Graph и sitemap.xml должны содержать
# абсолютные URL. По умолчанию http://localhost:3000. На проде — боевой домен.
NEXT_PUBLIC_SITE_URL=

# Адрес бэкенда для СЕРВЕРНОЙ стороны Next: серверные компоненты ходят в Spring
# напрямую, минуя браузер. Он же — цель rewrites() для /api/* (см. next.config.ts),
# то есть прямая замена прежнего vite-прокси. По умолчанию http://localhost:8080.
API_BASE_URL=

# Базовый URL бэкенда для БРАУЗЕРА. Пусто по умолчанию — фронт ходит на /api того
# же origin, а Next проксирует эти запросы в API_BASE_URL. Задавайте абсолютный
# URL, только если API и фронт развёрнуты на разных origin — тогда на бэкенде
# нужно настроить CORS, которого сейчас в SecurityConfig нет.
NEXT_PUBLIC_API_BASE_URL=
