# Базовый URL бэкенда. Пусто по умолчанию — фронт ходит на /api того же
# origin, а в разработке Vite (см. vite.config.ts) проксирует /api на
# http://localhost:8080. Задайте абсолютный URL, только если API и фронт
# развёрнуты на разных origin (в этом случае на бэкенде должен быть настроен CORS).
VITE_API_BASE_URL=
